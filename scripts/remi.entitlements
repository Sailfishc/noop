<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Dictation in the composer (nsh Speech): the hardened runtime needs this for the microphone. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- The login QR scanner (app/ui/qr-scanner.tsx): its web view's getUserMedia needs this for the camera. -->
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
