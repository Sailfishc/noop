{
  "name": "Remi",
  "id": "dev.noop.app",
  "version": "0.1.0",
  "build": 1,
  "appearance": "system",
  "macos": {
    "infoPlist": {
      "NSAppTransportSecurity": {
        "NSAllowsArbitraryLoads": true
      }
    }
  },
  "ios": {
    "infoPlist": {
      "NSAppTransportSecurity": {
        "NSAllowsArbitraryLoads": true
      }
    }
  },
  "theme": "theme.json",
  "web": {
    "host": "./host.js",
    "base": "/"
  },
  "capabilities": {
    "clipboard": true,
    "network": {
      "hosts": [
        "*"
      ]
    },
    "host": [
      "page",
      "pushState",
      "pushEnable",
      "pushDisable",
      "setSession",
      "setBadge",
      "clearNotifications",
      "vibrate",
      "speechState",
      "speechStart",
      "speechStop",
      "speechAbort"
    ],
    "picker": true,
    "speech": true,
    "notifications": true,
    "fs": {
      "read": [
        "${homeDir}"
      ]
    },
    "openUrl": {
      "schemes": [
        "https",
        "mailto"
      ]
    }
  },
  "icon": "icon.png"
}
